diff --git a/src/ak_pgvector.c b/src/ak_pgvector.c
new file mode 100644
index 0000000..df22db6
--- /dev/null
+++ b/src/ak_pgvector.c
@@ -0,0 +1,211 @@
+#include "postgres.h"
+
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "commands/trigger.h"
+
+#include "ak_pgvector.h"
+
+/* pgvector type definitions (Vector) */
+#include "vector.h"
+
+/*
+ * Global Aker state (one instance per PostgreSQL backend process).
+ */
+int ak_requests_processed = 0;
+anns_cache_c_wrapper_t* ak_cache = NULL;
+
+/*
+ * Export hook registered via on_proc_exit.
+ */
+static void
+akExportAndDestroy(int code, Datum arg)
+{
+    (void)code;
+    (void)arg;
+
+    if (ak_cache == NULL)
+        return;
+
+    /* Export trace/telemetry first, then release resources. */
+    // akerExportTraceToFiles(ak_cache);
+    akerDestroyAnnsCache(ak_cache);
+    ak_cache = NULL;
+}
+
+float
+akDistanceFunction(uint8_t* a, uint8_t* b, size_t dim)
+{
+    if (a == NULL || b == NULL || dim == 0)
+        return 0.0f;
+
+    float* fa = (float*)a;
+    float* fb = (float*)b;
+
+    /* Select distance metric based on the runtime configuration. */
+    if (ak_cache != NULL && ak_cache->parameter.distance_metric == 1)
+        return akerInnerProductDistance(fa, fb, dim);
+    return akerL2Distance(fa, fb, dim);
+}
+
+bool
+akConversionFunction(void* src, size_t src_size, size_t dim, void* dst, uint8_t* aux)
+{
+    (void)aux;
+
+    if (src == NULL || dst == NULL)
+        return false;
+
+    const size_t required = dim * sizeof(float);
+    if (src_size < required)
+        return false;
+
+    memcpy(dst, src, required);
+    return true;
+}
+
+void
+akResultConversionFunction(
+    uint64_t vector_id,
+    uint8_t* vector_data,
+    size_t vector_data_size,
+    uint64_t aux_1,
+    uint64_t aux_2)
+{
+    if (vector_data == NULL)
+        return;
+
+    if (vector_data_size < sizeof(struct AkResult))
+        return;
+
+    /* Build an AkResult prefix in the provided payload buffer. */
+    struct AkResult result;
+    memset(&result, 0, sizeof(result));
+
+    result.vector_id = vector_id;
+
+    /* aux_1 encodes a float distance, aux_2 encodes an ItemPointerData. */
+    memcpy(&result.distance, &aux_1, sizeof(float));
+    memcpy(&result.tid, &aux_2, sizeof(ItemPointerData));
+
+    memcpy(vector_data, &result, sizeof(result));
+}
+
+void
+akInitFromEnv(void)
+{
+    if (ak_cache != NULL)
+        return;
+
+    fprintf(stdout, "[Aker] Initializing from _PG_init (pid=%d)\n", getpid());
+    fflush(stdout);
+
+    anns_cache_parameter_c_t parameter_info;
+    memset(&parameter_info, 0, sizeof(parameter_info));
+
+    /* Environment variable AKER_CONFIG_PATH must point to the cache configuration file. */
+    char* config_path = getenv("AKER_CONFIG_PATH");
+    if (config_path == NULL)
+    {
+        fprintf(stdout, "[Aker] Environment variable AKER_CONFIG_PATH not set.\n");
+        fflush(stdout);
+        exit(-1);
+    }
+
+    fprintf(stdout, "[Aker] AKER_CONFIG_PATH=%s\n", config_path);
+    fflush(stdout);
+
+    akerImportAnnsCacheConfig(config_path, &parameter_info);
+
+    ak_cache = akerCreateAnnsCache(parameter_info);
+    if (ak_cache == NULL)
+    {
+        fprintf(stdout, "[Aker] Failed to create cache instance.\n");
+        fflush(stdout);
+        exit(-1);
+    }
+
+    fprintf(stdout, "[Aker] Cache initialized successfully (%p)\n", (void*)ak_cache);
+    fflush(stdout);
+}
+
+void
+akRegisterExitHook(void)
+{
+    on_proc_exit(akExportAndDestroy, 0);
+}
+
+/*
+ * SQL-level integration (used by stress workloads).
+ *
+ * These entry points are exposed to SQL so stress/mixed workloads can:
+ * - mark deleted vectors (tombstone)
+ * - invalidate a random fraction of the cache
+ */
+
+FUNCTION_PREFIX PG_FUNCTION_INFO_V1(aker_mark_del_trigger);
+Datum
+aker_mark_del_trigger(PG_FUNCTION_ARGS)
+{
+    TriggerData* trigdata;
+    Relation rel;
+    HeapTuple tuple;
+    const char* colname;
+    AttrNumber attnum;
+    bool is_null;
+    Datum d;
+
+    if (!CALLED_AS_TRIGGER(fcinfo))
+        ereport(ERROR, (errmsg("aker_mark_del_trigger: not called as trigger")));
+
+    trigdata = (TriggerData*)fcinfo->context;
+
+    if (!TRIGGER_FIRED_FOR_ROW(trigdata->tg_event))
+        ereport(ERROR, (errmsg("aker_mark_del_trigger: must be a row-level trigger")));
+
+    rel = trigdata->tg_relation;
+    if (rel->rd_rel->relkind != RELKIND_RELATION)
+        ereport(ERROR, (errmsg("aker_mark_del_trigger: not fired on a table")));
+
+    tuple = trigdata->tg_trigtuple;
+
+    colname = (trigdata->tg_trigger->tgnargs >= 1) ? trigdata->tg_trigger->tgargs[0] : "embedding";
+    attnum = get_attnum(RelationGetRelid(rel), colname);
+    if (attnum <= 0)
+        ereport(ERROR, (errmsg("aker_mark_del_trigger: column \"%s\" not found", colname)));
+
+    d = heap_getattr(tuple, attnum, RelationGetDescr(rel), &is_null);
+    if (!is_null && ak_cache != NULL)
+    {
+        Vector* vec = (Vector*)PG_DETOAST_DATUM(d);
+        const size_t bytes = (size_t)(VARSIZE_ANY_EXHDR(vec) - 4);
+
+        if (bytes > 0)
+        {
+            uint64_t vid = akerDefaultHash((char*)vec->x, bytes);
+            akerMarkVectorDeleted(ak_cache, vid);
+        }
+
+        if ((Pointer)vec != DatumGetPointer(d))
+            pfree(vec);
+    }
+
+    PG_RETURN_POINTER(trigdata->tg_trigtuple);
+}
+
+FUNCTION_PREFIX PG_FUNCTION_INFO_V1(aker_invalidate_random);
+Datum
+aker_invalidate_random(PG_FUNCTION_ARGS)
+{
+    float percent = (float)PG_GETARG_FLOAT8(0);
+    if (ak_cache != NULL)
+        akerStressTestInvalidateRandom(ak_cache, percent);
+
+    PG_RETURN_VOID();
+}
diff --git a/src/ak_pgvector.h b/src/ak_pgvector.h
new file mode 100644
index 0000000..3fe42d3
--- /dev/null
+++ b/src/ak_pgvector.h
@@ -0,0 +1,88 @@
+/*
+ * Aker integration helpers for pgvector.
+ *
+ * This module replaces the legacy glue code while preserving the
+ * same integration points in pgvector (scan/insert/trigger/exit hook).
+ *
+ * Legacy-compatible behavior:
+ * - vector_id is computed as a 64-bit hash of raw float bytes
+ * - cache-hit returns Heap TIDs without touching the underlying index
+ */
+
+#ifndef PGVECTOR_AK_PGVECTOR_H
+#define PGVECTOR_AK_PGVECTOR_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "postgres.h"
+#include "storage/itemptr.h"
+
+/* Aker C ABI (refactored snapshot). */
+#include "ak_anns_cache_c_wrapper.h"
+
+/* Opaque wrapper types used by pgvector integration code. */
+typedef char ak_vector_slot_t;
+typedef char ak_vector_view_t;
+typedef char ak_cache_entry_t;
+
+/*
+ * Global instance managed per PostgreSQL backend.
+ *
+ * SQL-visible entry points use the "aker_" prefix.
+ * Internally we use the Aker abbreviation "ak".
+ */
+extern int ak_requests_processed;
+extern anns_cache_c_wrapper_t* ak_cache;
+
+/*
+ * Result payload stored inside Aker's vector pool.
+ *
+ * Only this prefix is interpreted by the pgvector side when returning cached
+ * TIDs. The remainder of the Aker payload buffer (vector_in_bytes) is unused
+ * by pgvector and may be zero-filled.
+ *
+ */
+struct AkResult
+{
+    uint64_t vector_id;
+    ItemPointerData tid;
+    float distance;
+};
+
+/**
+ * @brief Distance function shim used by Aker.
+ *
+ * @param a Raw vector bytes (float array).
+ * @param b Raw vector bytes (float array).
+ * @param dim Vector dimension (number of float elements).
+ */
+float akDistanceFunction(uint8_t* a, uint8_t* b, size_t dim);
+
+/**
+ * @brief Conversion function shim (raw float bytes -> float array).
+ */
+bool akConversionFunction(void* src, size_t src_size, size_t dim, void* dst, uint8_t* aux);
+
+/**
+ * @brief Result transform shim used by Aker write-log paths.
+ */
+void akResultConversionFunction(
+    uint64_t vector_id,
+    uint8_t* vector_data,
+    size_t vector_data_size,
+    uint64_t aux_1,
+    uint64_t aux_2);
+
+/**
+ * @brief Initializes the global Aker instance from AKER_CONFIG_PATH.
+ */
+void akInitFromEnv(void);
+
+/**
+ * @brief Registers a backend exit hook to export traces and destroy the cache.
+ */
+void akRegisterExitHook(void);
+
+#endif /* PGVECTOR_AK_PGVECTOR_H */
