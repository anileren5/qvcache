@@ -1,6 +1,7 @@
 #include "postgres.h"
 
 #include <math.h>
+#include <string.h>
 
 #include "access/generic_xlog.h"
 #include "hnsw.h"
@@ -9,6 +10,9 @@
 #include "utils/datum.h"
 #include "utils/memutils.h"
 
+/* Aker integration helpers */
+#include "ak_pgvector.h"
+
 /*
  * Get the insert page
  */
@@ -753,6 +757,57 @@ HnswInsertTuple(Relation index, Datum *values, bool *isnull, ItemPointer heaptid
 		return;
 
 	HnswInsertTupleOnDisk(index, &support, value, heaptid, false);
+
+	/*
+	 * Aker write-log integration:
+	 * Register the inserted vector so that Standard mode can update cached results.
+	 */
+	if (ak_cache != NULL)
+	{
+		Vector* new_vec = DatumGetVector(value);
+		float* new_vec_raw = new_vec->x;
+		size_t new_vec_size = (size_t)new_vec->dim * sizeof(float);
+
+		Assert(new_vec_size == (size_t)(VARSIZE_ANY_EXHDR(new_vec) - 4));
+
+		uint64_t hashed_id = akerDefaultHash((char*)new_vec_raw, new_vec_size);
+
+		struct AkResult dummy_result;
+		memset(&dummy_result, 0, sizeof(dummy_result));
+		dummy_result.vector_id = hashed_id;
+		dummy_result.tid = *heaptid;
+		dummy_result.distance = 0.0f;
+
+		uint64_t aux_data_1 = 0;
+		uint64_t aux_data_2 = 0;
+		memcpy(&aux_data_1, &dummy_result.distance, sizeof(float));
+		memcpy(&aux_data_2, &dummy_result.tid, sizeof(ItemPointerData));
+
+		char* new_ak_vec_slot = akerCreateVectorSlot(
+			hashed_id,
+			new_vec_size,
+			(char*)new_vec_raw,
+			aux_data_1,
+			aux_data_2,
+			0.0f);
+
+		char* new_ak_vec_view = akerCreateVectorView(
+			new_ak_vec_slot,
+			(size_t)new_vec->dim,
+			new_vec_size,
+			akConversionFunction);
+
+		akerInsertWriteLogEntry(
+			ak_cache,
+			new_ak_vec_view,
+			akDistanceFunction,
+			akResultConversionFunction);
+
+		akerDestroyVectorView(new_ak_vec_view);
+		akerDestroyVectorSlot(new_ak_vec_slot);
+
+		ak_requests_processed++;
+	}
 }
 
 /*
